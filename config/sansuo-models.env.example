# SanSuo model configuration
# Copy these keys into .env on the target server, then restart the LibreChat api container.

# OpenAI-compatible model gateway.
# Public Bailian example:
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Intranet examples:
# QWEN_BASE_URL=http://your-internal-model-gateway.example.com/v1
# QWEN_BASE_URL=https://your-company-ai-gateway.example.com/compatible-mode/v1

# Keep this secret on the server. Do not commit real keys.
QWEN_API_KEY=replace-with-your-real-key

# Default text/chat model. Used for normal Chinese chat, file reasoning after sandbox reads,
# memory decisions, and default SanSuoMain conversations.
SANSUO_TEXT_MODEL=qwen3.5-397b-a17b

# Tool profile model. This can be the same underlying model ID as SANSUO_TEXT_MODEL.
# SanSuo routes sandbox-required requests to the "tool" profile in backend code,
# then applies fixed tool behavior (execute_code, tool-choice enforcement, and
# fallback no-thinking suppression when needed). If you do not have a separate
# no-thinking model ID, it is valid to keep this equal to SANSUO_TEXT_MODEL.
SANSUO_TOOL_MODEL=qwen3.5-397b-a17b

# Vision model. Used when the current user message includes image attachments.
# Replace this after intranet migration if your company provides a different VL model.
SANSUO_VISION_MODEL=qwen3-vl-plus

# Title model. SanSuoMain currently has a local title fallback, but this remains configured
# for compatibility with LibreChat title generation paths.
SANSUO_TITLE_MODEL=qwen3.5-397b-a17b

# Compatibility alias for older code paths.
QWEN_MODEL=${SANSUO_TEXT_MODEL}

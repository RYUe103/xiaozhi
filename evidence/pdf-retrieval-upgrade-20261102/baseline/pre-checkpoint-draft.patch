+/** Weighted fusion for independent retrieval channels.  Keyword is intentionally
+ * kept out of this helper's default callers when it duplicates BM25 postings. */
+function weightedReciprocalRankFusion(channels = [], { k = 60 } = {}) {
+  const byId = new Map();
+  for (const channel of channels) {
+    const weight = Number(channel.weight ?? 1);
+    if (!(weight > 0)) continue;
+    for (const [rank, item] of (channel.results || []).entries()) {
+      const id = item.record?.id || item.record?.chunkId || item.record?.sourceRecordId;
+      if (!id) continue;
+      const entry = byId.get(id) || { record: item.record, score: 0, sources: [], ranks: {} };
+      const source = channel.name || item.source || 'unknown';
+      entry.score += weight / (Number(k) + rank + 1);
+      if (!entry.sources.includes(source)) entry.sources.push(source);
+      entry.ranks[source] = rank + 1;
+      byId.set(id, entry);
+    }
+  }
+  return [...byId.values()].sort((a, b) => b.score - a.score || String(a.record.id).localeCompare(String(b.record.id)));
+}
+
+/** Keep channel-unique evidence alive before a reranker sees the pool. */
+function protectDiverseCandidates(fused = [], channels = [], { limit = 40, uniquePerChannel = 4, maxPerPage = 4 } = {}) {
+  const selected = [], seen = new Set(), pageCounts = new Map();
+  const add = (item, ignorePage = false) => {
+    const id = item.record?.id || item.record?.chunkId;
+    if (!id || seen.has(id)) return false;
+    const page = item.record?.pageStart ?? item.record?.page_start ?? null;
+    if (!ignorePage && page != null && (pageCounts.get(page) || 0) >= maxPerPage) return false;
+    seen.add(id); selected.push(item); if (page != null) pageCounts.set(page, (pageCounts.get(page) || 0) + 1); return true;
+  };
+  for (const channel of channels) {
+    let count = 0;
+    for (const item of channel.results || []) if (count < uniquePerChannel && add(item, true)) count++;
+  }
+  for (const item of fused) { if (selected.length >= limit) break; add(item); }
+  return selected.slice(0, limit);
+}
